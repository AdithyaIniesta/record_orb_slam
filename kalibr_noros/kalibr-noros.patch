+def resolveTopicPath(folder, topic, wanted):
+    """Find the directory for a ROS-style topic inside a dataset folder (no ROS needed).
+
+    '/imu0' (or '/cam0/image_raw') is looked up as folder/imu0 and folder/mav0/imu0 (EuRoC layout), each
+    optionally with a 'data' subfolder. 'wanted' says whether a candidate directory is the right one.
+    """
+    names = [n for n in topic.strip("/").split("/") if n]
+    for base in (folder, os.path.join(folder, "mav0")):
+        for n in names:
+            for sub in ("", "data"):
+                cand = os.path.join(base, n, sub) if sub else os.path.join(base, n)
+                if wanted(cand):
+                    return cand
+    return None
+
+
+class FolderImuDatasetReader(object):
+    """Drop-in replacement for BagImuDatasetReader that reads a EuRoC-style IMU csv (no ROS).
+
+    The 'topic' names the IMU folder (e.g. /imu0). The file is imu0/data.csv (or mav0/imu0/data.csv) with columns
+        timestamp [ns], w_x, w_y, w_z [rad/s], a_x, a_y, a_z [m/s^2]
+    and '#' header lines. Samples are sorted by time and samples whose time does not increase are dropped.
+    """
+
+    def __init__(self, folder, imutopic, bag_from_to=None, perform_synchronization=False):
+        self.bagfile = folder
+        self.topic = imutopic
+        if imutopic is None:
+            raise RuntimeError("Please pass the IMU folder name (e.g. /imu0) as the topic.")
+        csvdir = resolveTopicPath(folder, imutopic, lambda d: os.path.isfile(os.path.join(d, "data.csv")))
+        if csvdir is None:
+            raise RuntimeError("Could not find {0}/data.csv for IMU topic {1} in {2}".format(
+                imutopic.strip("/"), imutopic, folder))
+        raw = np.loadtxt(os.path.join(csvdir, "data.csv"), delimiter=",", comments="#", ndmin=2)
+        if raw.shape[1] < 7:
+            raise RuntimeError("{0}: expected 7 columns (t_ns, w xyz, a xyz), found {1}".format(csvdir, raw.shape[1]))
+        raw = raw[np.argsort(raw[:, 0], kind="stable")]
+        keep = np.concatenate(([True], np.diff(raw[:, 0]) > 0))
+        if not keep.all():
+            sm.logWarn("FolderImuDatasetReader: dropped {0} samples whose timestamp did not increase.".format(int((~keep).sum())))
+        self.data = raw[keep]
+        self.indices = np.arange(len(self.data))
+        if bag_from_to:
+            self.indices = self.truncateIndicesFromTime(self.indices, bag_from_to)
+        self.index = self.indices          # the calibrator prints len(reader.index)
+
+    def truncateIndicesFromTime(self, indices, bag_from_to):
+        if bag_from_to[0] >= bag_from_to[1]:
+            raise RuntimeError("Start time must be smaller than end time.")
+        t = self.data[:, 0] / 1.0e9
+        start = t[0]
+        valid = [i for i in indices if start + bag_from_to[0] <= t[i] <= start + bag_from_to[1]]
+        sm.logWarn("FolderImuDatasetReader: truncated {0} / {1} messages.".format(len(indices) - len(valid), len(indices)))
+        return np.array(valid, dtype=int)
+
+    def __iter__(self):
+        return self.readDataset()
+
+    def readDataset(self):
+        return BagImuDatasetReaderIterator(self, self.indices)
+
+    def readDatasetShuffle(self):
+        indices = np.array(self.indices)
+        np.random.shuffle(indices)
+        return BagImuDatasetReaderIterator(self, indices)
+
+    def numMessages(self):
+        return len(self.indices)
+
+    def getMessage(self, idx):
+        row = self.data[idx]
+        ns = int(round(row[0]))
+        return (acv.Time(ns // 1000000000, ns % 1000000000), np.array(row[1:4]), np.array(row[4:7]))
