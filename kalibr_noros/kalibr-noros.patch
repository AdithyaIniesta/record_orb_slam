+IMAGE_EXTENSIONS = (".png", ".jpg", ".jpeg", ".bmp", ".tif", ".tiff", ".pgm")
+
+
+def _timestampFromName(path, fallback_index):
+  """Filename stem -> (secs, nsecs). Digits only = integer nanoseconds (EuRoC),
+  containing a '.' = float seconds. Anything else = frame order at 10 Hz."""
+  stem = os.path.splitext(os.path.basename(path))[0]
+  if stem.isdigit():
+    ns = int(stem)
+    return ns // 1000000000, ns % 1000000000, True
+  try:
+    t = float(stem)
+    secs = int(t)
+    return secs, int(round((t - secs) * 1e9)), True
+  except ValueError:
+    return fallback_index // 10, (fallback_index % 10) * 100000000, False
+
+
+class FolderImageDatasetReader(object):
+  """Drop-in replacement for BagImageDatasetReader that reads a directory of images.
+
+  The 'topic' is the name of a subfolder of 'folder' (e.g. cam0). Images in different
+  camera folders are matched by timestamp, so name the files with the capture time
+  (nanoseconds or float seconds) and use the same name for frames taken together.
+  """
+
+  def __init__(self, folder, imagetopic, bag_from_to=None, perform_synchronization=False, bag_freq=None):
+    self.bagfile = folder
+    self.topic = imagetopic
+    if imagetopic is None:
+      raise RuntimeError("Please pass the camera subfolder name (e.g. cam0) as the topic.")
+    # '/cam0/image_raw' or 'cam0' -> folder/cam0, folder/cam0/data or folder/mav0/cam0/data (EuRoC layout)
+    from .ImuDatasetReader import resolveTopicPath
+    def _has_images(d):
+      return os.path.isdir(d) and any(f.lower().endswith(IMAGE_EXTENSIONS) for f in os.listdir(d))
+    camdir = resolveTopicPath(folder, imagetopic, _has_images)
+    if camdir is None:
+      raise RuntimeError("Could not find images for camera topic {0} in {1} (looked for {2}, {2}/data, "
+                         "mav0/{2}/data)".format(imagetopic, folder, imagetopic.strip("/").split("/")[0]))
+    files = sorted(f for f in glob.glob(os.path.join(camdir, "*")) if f.lower().endswith(IMAGE_EXTENSIONS))
+    if not files:
+      raise RuntimeError("No images found in {0}".format(camdir))
+
+    entries = []
+    named = 0
+    for i, f in enumerate(files):
+      secs, nsecs, from_name = _timestampFromName(f, i)
+      named += from_name
+      entries.append((secs * 1000000000 + nsecs, secs, nsecs, f))
+    if named != len(files):
+      sm.logWarn("FolderImageDatasetReader: {0} has non-numeric filenames; using file order "
+                 "as time (frames are paired across cameras by index).".format(camdir))
+    entries.sort()
+    self.entries = entries
+    self.indices = np.arange(len(entries))
+
+    if bag_from_to:
+      self.indices = self.truncateIndicesFromTime(self.indices, bag_from_to)
+    if bag_freq:
+      self.indices = self.truncateIndicesFromFreq(self.indices, bag_freq)
+
+  def _t(self, idx):
+    return self.entries[idx][0] / 1.0e9
+
+  def truncateIndicesFromTime(self, indices, bag_from_to):
+    if bag_from_to[0] >= bag_from_to[1]:
+      raise RuntimeError("Start time must be smaller than end time.")
+    start = self._t(0)
+    valid = [i for i in indices if start + bag_from_to[0] <= self._t(i) <= start + bag_from_to[1]]
+    sm.logWarn("FolderImageDatasetReader: truncated {0} / {1} images (from-to).".format(len(indices) - len(valid), len(indices)))
+    return np.array(valid, dtype=int)
+
+  def truncateIndicesFromFreq(self, indices, freq):
+    if freq < 0.0:
+      raise RuntimeError("Frequency {0} Hz is smaller 0".format(freq))
+    last = None
+    valid = []
+    for i in indices:
+      t = self._t(i)
+      if last is None or (t - last) >= 1.0 / freq:
+        last = t
+        valid.append(i)
+    sm.logWarn("FolderImageDatasetReader: truncated {0} / {1} images (frequency)".format(len(indices) - len(valid), len(indices)))
+    return np.array(valid, dtype=int)
+
+  def __iter__(self):
+    return self.readDataset()
+
+  def readDataset(self):
+    return BagImageDatasetReaderIterator(self, self.indices)
+
+  def readDatasetShuffle(self):
+    indices = np.array(self.indices)
+    np.random.shuffle(indices)
+    return BagImageDatasetReaderIterator(self, indices)
+
+  def numImages(self):
+    return len(self.indices)
+
+  def getImage(self, idx):
+    _, secs, nsecs, path = self.entries[idx]
+    img = cv2.imread(path, cv2.IMREAD_UNCHANGED)
+    if img is None:
+      raise RuntimeError("Could not read image {0}".format(path))
+    if img.dtype == np.uint16:
+      img = (img / 256).astype("uint8")
+    if img.ndim == 3:
+      img = cv2.cvtColor(img, cv2.COLOR_BGRA2GRAY if img.shape[2] == 4 else cv2.COLOR_BGR2GRAY)
+    return (acv.Time(secs, nsecs), img)
